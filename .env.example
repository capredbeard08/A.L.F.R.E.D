# Copy to .env and fill in. Never commit real values.
# .env is gitignored above; keep it that way.

# Required for `alfred ask`, `alfred chat`, and `alfred research --ask`.
ALFRED_API_KEY=

# Optional. Any OpenAI-compatible chat-completions endpoint.
# ALFRED_API_BASE=https://api.openai.com/v1

# Optional. Model name served by that endpoint.
# ALFRED_MODEL=gpt-4o-mini

# Optional. Enables the keyed web-search provider (recommended for reliable
# research; the keyless urllib fallback is rate-limited).
# TAVILY_API_KEY=
# SEARCH_API_KEY=
